### List all entities in keyValues mode
GET http://{{orion}}/v2/entities?options=keyValues
Accept: application/json

### List all entities in keyValues mode with type = Sensor 
GET http://{{orion}}/v2/entities?options=keyValues&type=Sensor
Accept: application/json

### List humidity attribute of all Sensor entities in keyValues mode
GET http://{{orion}}/v2/entities?options=keyValues&type=Sensor&attrs=humidity
Accept: application/json

### Delete entity
DELETE http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:001


# ATTRIBUTE MANAGEMENT
## READ
### Get all attributes of an entity
GET http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:002/attrs?options=keyValues
Accept: application/json

### Get specific attribute of an entity
GET http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:002/attrs/temperature
Accept: application/json    

### Get value of specific attribute of an entity
GET http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:002/attrs/humidity/value
Accept: text/plain

# Queries with filter
### List all entities of type Sensor
GET http://{{orion}}/v2/entities?type=Sensor

### List all entities of type Sensor with temperature less than 21
GET http://{{orion}}/v2/entities?type=Sensor&q=temperature<21&options=keyValues
Accept: application/json



 UPDATE Attributes
### Add or update attributes of an entity
POST http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:002/attrs
Content-Type: application/json

{
  "batteryLevel": {
      "type": "Integer",
      "value": 50
  }
}

### Get value of Sensor entities
GET http://{{orion}}/v2/entities?type=Sensor&options=keyValues
Accept: application/json


### UPDATE attributes of an entity using PATCH
PATCH http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:003/attrs
Content-Type: application/json

{
  "batteryLevel": {
      "value": 75
  },
  "temperature": {
      "value": 22.5
      }   
}


### Get value of Sensor entities
GET http://{{orion}}/v2/entities?type=Sensor&options=keyValues
Accept: application/json



### REPLACE all attributes of an entity using PUT
PUT http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:002/attrs
Content-Type: application/json 

{  "name": {
      "type": "Text",
      "value": "SENSOR 002"
  },
  "humidity": {
      "type": "Integer",
      "value": 7
  },
  "luminosity": {
      "type": "Number",
      "value": 635.5
  }
}

### REPLACE an specific attribute of an entity using PUT
PUT http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:002/attrs/luminosity
Content-Type: application/json 

{  
  "type": "Number",
  "value": 700.0,
  "metadata": {
      "unitCode": {
          "type": "Text",
          "value": "MTK"
      }
    }
}


### Get value of Sensor entities
GET http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:002
Accept: application/json

### UPDATE value of an specific attribute of an entity using PUT
PUT http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:002/attrs/luminosity/value
Content-Type: text/plain

1025.0

### DELETE specific attribute of an entity
DELETE http://{{orion}}/v2/entities/urn:ngsi-ld:Sensor:002/attrs/luminosity


