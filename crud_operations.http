}

### List all entities normalized
GET http://{{orion}}/v2/entities
Accept: application/json

### List all entities in keyValues mode
GET http://{{orion}}/v2/entities?options=keyValues
Accept: application/json

### List all entities in valueOnly mode
GET http://{{orion}}/v2/entities?options=values
Accept: application/json

### List all entities in keyValues mode with attribute location
GET http://{{orion}}/v2/entities?options=keyValues&attrs=floor
Accept: application/json

### Create entity for sensor 1
POST http://{{orion}}/v2/entities
Content-Type: application/json

{
  "id": "urn:ngsi-ld:Sensor:001",
  "type": "Sensor",
  "temperature" : {
      "type": "Number",
      "value": 20.5,
      "metadata": {
          "unitCode": {
              "type": "Text",
              "value": "CEL"
          }
      }   
  },
  "humidity" : {
      "type": "Number",
      "value": 55,
      "metadata": {
          "unitCode": {
              "type": "Text",
              "value": "P1"
          }
      }   
  },
  "batteryLevel" : {
      "type": "Number",
      "value": 85,
      "metadata": {
          "unitCode": {
              "type": "Text",
              "value": "P1"
          }
      }   
  },
  "refRoom":{
      "type": "Relationship",
      "value": {
        "type": "Text", 
        "value": "urn:ngsi-ld:Room:livingroom"}
      }
}

