# CRUD Operations for FIWARE NGSI-v2

#General settings
@orion=localhost:1026

#Test Orion Context Broker is working
GET http://{{orion}}/version

# ENTITY MANAGEMENT
### Add entity urn:ngsi-ld:Room:livingroom
POST http://{{orion}}/v2/entities
Content-Type: application/json

 {
    "id": "urn:ngsi-ld:Room:livingroom",
    "type": "Room",
    "name": {
        "type": "Text",
        "value": "Living Room"  
    },
    "area": {
        "type": "Number",
        "value": 20,
        "metadata": {
            "unitCode": {
                "type": "Text",
                "value": "MTK"
            }
        }   
    },
    "floor":{  
        "type": "Number",
        "value": 1
    }
}


### Add entity urn:ngsi-ld:Room:kitchen
POST http://{{orion}}/v2/entities
Content-type: application/json

{
    "id": "urn:ngsi-ld:Room:kitchen",
    "type": "Room",
    "name": {
        "type": "Text",
        "value": "Kitchen"  
    },
    "area": {
        "type": "Number",
        "value": 14,
        "metadata": {
            "unitCode": {
                "type": "Text",
                "value": "MTK"
            }
        }   
    },
    "floor":{  
        "type": "Number",
        "value": 1
    }
}



### Add entity urn:ngsi-ld:Room:bedroom1
